<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F7FFF9">

    <!-- Icon sukses -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅"
        android:textSize="64sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Pembayaran Berhasil"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1C3C58" />

    <!-- Info transaksi (diisi dari Activity) -->
    <TextView
        android:id="@+id/tvSuccessMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Terima kasih sudah berbelanja di TOKOMPUTER"
        android:textColor="#333333"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#1C3C58"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="Kembali ke Beranda"
        android:textColor="#FFFFFF" />

</LinearLayout>