<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#007DF4"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Verifikasi OTP"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subjudul -->
        <TextView
            android:id="@+id/tvOtpSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Kode OTP telah dikirim ke email kamu"
            android:textColor="#777777"
            android:textSize="13sp" />

        <!-- Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_lock_idle_alarm"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:00"
                android:textColor="#1C3C58"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="tersisa"
                android:textColor="#777777"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Input OTP -->
        <EditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:hint="Masukkan 6 digit OTP"
            android:inputType="number"
            android:letterSpacing="0.1"
            android:maxLength="6"
            android:padding="12dp"
            android:textSize="20sp" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Tombol Verifikasi -->
        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#90CAF9"
            android:text="Verifikasi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:background="#E0E0E0" />

        <!-- Resend OTP -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tidak menerima kode?"
            android:textColor="#777777"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnResendOtp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#E0E0E0"
            android:text="Kirim Ulang OTP"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:enabled="false" />

        <!-- Info timer resend -->
        <TextView
            android:id="@+id/tvResendInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Tombol aktif setelah timer habis"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

    </LinearLayout>
</LinearLayout>